# --- Postgres ---
POSTGRES_USER=knowledge_stack
POSTGRES_PASSWORD=knowledge_stack
POSTGRES_DB=knowledge_stack

DATABASE_URL=postgresql://knowledge_stack:knowledge_stack@localhost:5432/knowledge_stack

# --- Auth ---
JWT_SECRET=dev-secret-change-me

# --- Redis / SAQ ---
REDIS_URL=redis://redis:6379

# --- RustFS (shared S3-compatible storage for Milvus and the app) ---
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
# Bucket the app uses for raw uploaded files - kept separate from Milvus bucket.
RUSTFS_BUCKET_NAME=content-bucket
# Bucket Milvus manages itself for segment/index storage.
MILVUS_BUCKET_NAME=milvus-bucket

# --- Milvus ---
MILVUS_URI=http://milvus:19530

EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

RERANKER_ENABLED=false
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
